{
  "name": "limitless-claude",
  "version": "8.5.0",
  "description": "Limitless Claude 8.5 - Production Control Plane & High-Performance Routing Ecosystem for OmniRoute & Claude Desktop. Zero vendor lock-in, priority failovers, official system cognitive directives, 119 Orchestra skills, and sub-second multi-turn responsiveness.",
  "license": "MIT",
  "author": "mahik504",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahik504/limitless-claude.git"
  },
  "keywords": [
    "claude",
    "anthropic",
    "omniroute",
    "coding-agent",
    "developer-tools",
    "llm-router",
    "orchestra",
    "tui",
    "ollama",
    "cline",
    "ai"
  ],
  "bin": {
    "limitless": "./bin/limitless.js"
  },
  "files": [
    "bin",
    "config",
    "docs",
    "prompts",
    "scripts",
    "src",
    "install.ps1",
    "install.sh",
    "README.md",
    "LICENSE",
    "VERSION"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:all": "node scripts/install-all.js",
    "install:clean": "node scripts/install-all.js --clean",
    "setup": "node scripts/setup.js",
    "verify": "node scripts/verify-combos.js",
    "discover": "node scripts/discover.js",
    "switch-profile": "node scripts/switch-profile.js",
    "launcher": "node scripts/launcher.js",
    "rollback": "node scripts/rollback.js",
    "pin": "node scripts/pin.js",
    "checkpoint": "node scripts/undo.js",
    "undo": "node scripts/undo.js",
    "tui": "node scripts/tui.js",
    "dashboard": "node scripts/dashboard.js",
    "stats": "node scripts/stats.js",
    "tokens": "node scripts/stats.js",
    "orchestra": "node scripts/orchestra.js",
    "benchmark": "node scripts/benchmark.js",
    "acceptance": "node scripts/e2e-acceptance.js",
    "prepack": "node --test test/*.test.js",
    "test": "node --test test/*.test.js"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
